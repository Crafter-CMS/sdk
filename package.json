{
  "name": "@crafter-cms/sdk",
  "version": "1.0.0",
  "description": "Storefront JavaScript/TypeScript SDK for Crafter Liquid themes and headless applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/crafter.min.js",
  "jsdelivr": "./dist/crafter.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/crafter.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crafter",
    "storefront",
    "sdk",
    "liquid",
    "theme",
    "ecommerce"
  ],
  "author": "Crafter",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}