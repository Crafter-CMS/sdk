# Copy to .env and fill in. Never commit .env: it holds your client secret.

# Credentials from the panel (Developer > Apps > your app). The client secret is shown only once.
CRAFTER_CLIENT_ID=capp_replace_me
CRAFTER_CLIENT_SECRET=crft_acs_replace_me

# Public base URL of this app, without a trailing slash. Register "<APP_BASE_URL>/oauth/callback" as a redirect URI,
# "<APP_BASE_URL>/install" as the app URL and "<APP_BASE_URL>/embed" as the embed URL.
# Webhooks need a public https URL (for example a tunnel); with http://localhost the app runs without webhooks.
APP_BASE_URL=http://localhost:3000
PORT=3000

# Crafter API (OAuth, JWKS) and the public /v1 API. Defaults: the dev environment.
CRAFTER_API_URL=https://dev-api.crafter.net.tr
CRAFTER_V1_URL=https://dev-api.crafterpayments.com/v1

# Space-separated scopes to request. Must be a subset of the scopes in the app's published manifest.
CRAFTER_SCOPES=read_store read_orders webhooks:write

# Expected "iss" of embedded session tokens. Defaults to CRAFTER_API_URL.
# CRAFTER_SESSION_ISSUER=https://dev-api.crafter.net.tr

# Origins allowed to frame the embedded page (space-separated): the Crafter panel of the environment you test on.
CRAFTER_PANEL_ORIGINS=https://app.crafter.net.tr

# Where tokens are stored (example only: a local JSON file).
DATA_FILE=./data/tokens.json
